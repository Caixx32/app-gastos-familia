rules_version = '2';

// Solo estas dos cuentas pueden leer y escribir los gastos.
// Cambiá los correos por los que usan ustedes (los mismos que crean en Authentication).
service cloud.firestore {
  match /databases/{database}/documents {
    match /familias/{familia}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['persona1@gmail.com', 'persona2@gmail.com'];
    }
  }
}
